% ====================================================
%  طراحی کنترل‌کننده فیدبک حالت با متلب
% ====================================================
clear; clc; close all;

% تعریف ماتریس‌های سیستم
A = [0 1; 4 0];
B = [0; 1];
C = [1 0];

% مکان قطب‌های مطلوب
poles = [-2+2i, -2-2i];

% محاسبه بهره فیدبک حالت با روش آکرمن
K = acker(A, B, poles);

% سیستم حلقه بسته
sys_cl = ss(A - B*K, B, C, 0);

% نمایش پاسخ پله
figure;
step(sys_cl);
title('پاسخ پله سیستم حلقه بسته');
grid on;

% نمایش بهره محاسبه‌شده
disp('بهره فیدبک حالت:');
disp(K);
